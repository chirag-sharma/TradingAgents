# TradingAgents Environment Configuration
# Copy this file to .env and fill in your API keys

# =============================================================================
# LLM PROVIDER CONFIGURATION (Choose ONE)
# =============================================================================

# Option 1: OpenAI
# OPENAI_API_KEY=sk-your-openai-api-key-here
# TRADINGAGENTS_LLM_PROVIDER=openai
# TRADINGAGENTS_DEEP_THINK_LLM=gpt-4o-mini
# TRADINGAGENTS_QUICK_THINK_LLM=gpt-4o-mini
# TRADINGAGENTS_BACKEND_URL=https://api.openai.com/v1

# Option 2: Google Gemini
# GOOGLE_API_KEY=your-google-api-key-here
# TRADINGAGENTS_LLM_PROVIDER=google
# TRADINGAGENTS_DEEP_THINK_LLM=gemini-2.0-flash
# TRADINGAGENTS_QUICK_THINK_LLM=gemini-2.0-flash
# TRADINGAGENTS_BACKEND_URL=https://generativelanguage.googleapis.com/v1

# Option 3: Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# TRADINGAGENTS_LLM_PROVIDER=anthropic
# TRADINGAGENTS_DEEP_THINK_LLM=claude-3-sonnet-20240229
# TRADINGAGENTS_QUICK_THINK_LLM=claude-3-haiku-20240307
# TRADINGAGENTS_BACKEND_URL=https://api.anthropic.com

# =============================================================================
# MARKET CONFIGURATION
# =============================================================================

# Choose target market: "us" or "india"
TRADINGAGENTS_MARKET=us

# =============================================================================
# OPTIONAL: ADDITIONAL DATA SOURCES
# =============================================================================

# Financial data APIs (optional but recommended)
# FINNHUB_API_KEY=your-finnhub-api-key
# ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key

# Reddit API for sentiment analysis (optional)
# REDDIT_CLIENT_ID=your-reddit-client-id
# REDDIT_CLIENT_SECRET=your-reddit-client-secret
# REDDIT_USER_AGENT=TradingAgents/1.0

# =============================================================================
# FRAMEWORK SETTINGS
# =============================================================================

# Enable/disable online data fetching
TRADINGAGENTS_ONLINE_TOOLS=true

# Number of debate rounds between agents
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1

# Data storage directory
TRADINGAGENTS_DATA_DIR=./data

# Results storage directory
TRADINGAGENTS_RESULTS_DIR=./results
